import { ScrollView, CheckBox, Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: false;
    out property <color> canvas: dark ? #121e1b : #f3f6f3;
    out property <color> card: dark ? #1a2924 : #ffffff;
    out property <color> ink: dark ? #e7f0e9 : #182d25;
    out property <color> muted: dark ? #a0b5aa : #74837b;
    out property <color> line: dark ? #30463a : #e2e8e4;
    out property <color> accent: dark ? #9de7a5 : #236849;
    out property <color> soft: dark ? #263c30 : #eaf1e8;
    out property <color> control: dark ? #203129 : #f7f9f8;
    out property <color> disabled-ink: dark ? #81978a : #839087;
    out property <color> progress-track: dark ? #233329 : #e6ece8;
}

component Label inherits Text {
    color: Theme.ink;
    font-size: 14px;
    overflow: elide;
}

component Muted inherits Label { color: Theme.muted; font-size: 12px; }

component Action inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <length> icon-width: 18px;
    in property <brush> icon-color: transparent;
    in property <bool> primary: false;
    in property <bool> soft: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    min-width: button-content.min-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: 36px;
    border-radius: 8px;
    background: !root.enabled ? Theme.control : root.primary ? (touch.pressed ? #1b563c : touch.has-hover ? #337d57 : #236849) : root.soft || touch.has-hover ? Theme.soft : Theme.card;
    border-width: 1px;
    border-color: focus.has-focus && root.enabled ? Theme.accent : root.primary && root.enabled ? #236849 : root.soft && root.enabled ? transparent : Theme.line;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    animate background { duration: 120ms; }
    forward-focus: focus;
    button-content := HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 7px; alignment: center;
        if root.icon.width > 0: Rectangle {
            width: root.icon-width; background: transparent;
            Image {
                y: (parent.height - self.height) / 2; height: 18px; width: parent.width;
                source: root.icon; image-fit: contain; colorize: root.icon-color;
            }
        }
        Text { text: root.text; color: !root.enabled ? Theme.disabled-ink : root.primary ? #ffffff : root.danger ? #bf6253 : root.soft ? Theme.accent : Theme.ink; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; font-weight: root.primary ? 600 : 500; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <bool> enabled: true;
    in-out property <string> text;
    spacing: 7px;
    vertical-stretch: 0;
    Label { text: root.label; font-size: 12px; font-weight: 600; }
    Rectangle {
        height: 38px;
        border-radius: 8px;
        background: Theme.control;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.line;
        if root.text == "": Muted { x: 12px; width: parent.width - 24px; height: parent.height; text: root.placeholder; vertical-alignment: center; }
        input := TextInput {
            x: 12px; width: parent.width - 24px; height: parent.height;
            text <=> root.text;
            color: Theme.ink;
            font-size: 14px;
            single-line: true;
            vertical-alignment: center;
            input-type: root.secret ? InputType.password : InputType.text;
            enabled: root.enabled;
            selection-background-color: Theme.accent;
            selection-foreground-color: #ffffff;
            accessible-label: root.label;
        }
    }
}

component Select inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in property <string> label: "选择路线";
    in-out property <int> current-index: 0;
    out property <string> current-value: current-index >= 0 && current-index < model.length ? model[current-index] : "";
    private property <bool> popup-focused;
    private property <length> popup-scroll-y;
    callback selected(string);
    height: 38px; min-width: 120px; vertical-stretch: 0;
    border-radius: 8px; background: Theme.control; border-width: 1px;
    border-color: focus.has-focus || root.popup-focused ? Theme.accent : Theme.line;
    forward-focus: focus;
    accessible-role: combobox; accessible-label: root.label;
    accessible-enabled: root.enabled; accessible-value: root.current-value;
    accessible-expandable: true; accessible-expanded: root.popup-focused;
    accessible-action-expand => { root.open-popup(); }

    function reveal-current() { root.popup-scroll-y = -Math.max(0, root.current-index - 2) * 34px; }
    function choose(index: int) {
        if root.enabled && index >= 0 && index < root.model.length {
            root.current-index = index;
            root.selected(root.model[index]);
            root.reveal-current();
        }
    }
    function open-popup() {
        if root.enabled && root.model.length > 0 { root.reveal-current(); popup.show(); }
    }
    Label { x: 12px; width: parent.width - 42px; height: parent.height; text: root.current-value; color: root.enabled ? Theme.ink : Theme.disabled-ink; vertical-alignment: center; accessible-role: none; }
    Path { x: parent.width - 25px; y: (parent.height - 8px) / 2; width: 10px; height: 8px; viewbox-width: 10; viewbox-height: 8; fill: transparent; stroke: Theme.muted; stroke-width: 1.5px; commands: "M1 2 L5 6 L9 2"; }
    focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if self.has-focus { root.popup-focused = false; } }
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.choose(Math.max(0, root.current-index - 1)); return accept; }
            if event.text == Key.DownArrow { root.choose(Math.min(root.model.length - 1, root.current-index + 1)); return accept; }
            if event.text == Key.Return || event.text == " " { root.open-popup(); return accept; }
            return reject;
        }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.open-popup(); } }
    popup := PopupWindow {
        x: 0; y: root.height + 4px; width: root.width; height: Math.min(6, root.model.length) * 34px + 8px;
        close-policy: close-on-click-outside; forward-focus: menu-focus;
        Rectangle {
            border-radius: 8px; background: Theme.card; border-width: 1px; border-color: Theme.line;
            menu-focus := FocusScope {
                focus-changed-event => { root.popup-focused = self.has-focus; }
                key-pressed(event) => {
                    if event.text == Key.UpArrow { root.choose(Math.max(0, root.current-index - 1)); return accept; }
                    if event.text == Key.DownArrow { root.choose(Math.min(root.model.length - 1, root.current-index + 1)); return accept; }
                    if event.text == Key.Return || event.text == Key.Escape || event.text == " " { popup.close(); focus.focus(); return accept; }
                    if event.text == Key.Tab { popup.close(); focus.focus(); return reject; }
                    return reject;
                }
                items := ScrollView {
                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    viewport-width: self.visible-width;
                    viewport-y <=> root.popup-scroll-y;
                    VerticalLayout {
                        alignment: start; spacing: 0px;
                        for value[index] in root.model: Rectangle {
                            height: 34px; border-radius: 5px;
                            background: index == root.current-index || row-touch.has-hover ? Theme.soft : transparent;
                            Label { x: 10px; width: parent.width - 20px; height: parent.height; text: value; font-size: 13px; vertical-alignment: center; }
                            accessible-role: list-item; accessible-label: value;
                            row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(index); popup.close(); focus.focus(); } }
                        }
                    }
                }
            }
        }
    }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 40px;
    border-radius: 8px;
    background: root.active ? #ffffff1a : touch.has-hover || focus.has-focus ? #ffffff0e : transparent;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        Text { text: root.label; color: root.active ? #ffffff : #ffffffa6; font-size: 13px; vertical-alignment: center; font-weight: root.active ? 600 : 400; }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    focus := FocusScope {
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
    forward-focus: focus;
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "SJTU RunningMan";
    icon: @image-url("../../assets/SJTURM.png");
    preferred-width: 1120px;
    preferred-height: 820px;
    min-width: 1040px;
    min-height: 700px;
    background: Theme.canvas;
    in property <string> ui-font;
    default-font-family: root.ui-font;
    default-font-size: 14px;

    in-out property <bool> dark <=> Theme.dark;
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; root.refresh-preview(); }
    in-out property <int> page: 0;
    in-out property <string> runs: "1";
    in-out property <string> distance: "4";
    in-out property <string> run-date;
    in-out property <string> run-time: "08:00:00";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> captcha;
    in property <bool> manual-captcha: false;
    in-out property <string> two-factor-code;
    in-out property <int> route-index: 0;
    in property <[string]> route-names;
    in property <image> route-image;
    in property <image> captcha-image;
    in property <string> route-title: "default";
    in property <string> route-summary;
    in property <string> preview-summary: "离线预览 · 无需登录";
    in property <string> route-warning;
    in property <bool> can-delete: false;
    in property <bool> busy: false;
    in property <bool> logged-in: false;
    in property <bool> network-busy: false;
    in property <string> status: "准备就绪";
    in property <int> progress: 0;
    in property <string> log-text;
    in property <string> notice;
    in property <string> version;
    in property <string> update-status: "按需检查更新，启动时不请求网络。";
    // 0：关闭；1：账号登录（图形验证码自动识别）；2：二次验证。
    in-out property <int> login-stage: 0;
    in-out property <bool> consent-open: true;
    in-out property <bool> consent-checked: false;
    in-out property <bool> delete-open: false;
    in-out property <bool> upload-open: false;
    in-out property <int> two-factor-method: 0;

    callback preview;
    callback import-route;
    callback delete-route;
    callback select-route(int);
    callback planner;
    callback open-map;
    callback start-task;
    callback stop-task;
    callback prepare-login;
    callback submit-login;
    callback cancel-login;
    callback send-code;
    callback verify-code;
    callback logout;
    callback check-update;
    callback open-shuiyuan;
    callback open-project;
    callback clear-log;
    callback quit;
    callback receive-events;
    callback refresh-preview;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 208px;
            background: #182f24;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                HorizontalLayout {
                    padding-top: 4px; padding-bottom: 22px; spacing: 10px;
                    Rectangle {
                        width: 36px; height: 36px; border-radius: 8px; clip: true; background: transparent;
                        Image { source: @image-url("../../assets/SJTURM.png"); width: parent.width; height: parent.height; image-fit: contain; }
                    }
                    VerticalLayout {
                        spacing: 4px; alignment: center;
                        Text { text: "RunningMan"; color: #f0f6e9; font-size: 16px; font-weight: 700; }
                        Text { text: "SJTU / 校园跑"; color: #94af9a; font-size: 10px; }
                    }
                }
                NavItem { label: "跑步工作台"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { label: "路线管理"; active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { label: "任务日志"; active: root.page == 2; clicked => { root.page = 2; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                NavItem { label: "关于软件"; active: root.page == 3; clicked => { root.page = 3; } }
                Text { text: root.version; color: #8ca794; font-size: 10px; height: 28px; vertical-alignment: center; x: 14px; }
            }
        }
        VerticalLayout {
            padding: 20px; spacing: 14px;
            HorizontalLayout {
                height: 32px; spacing: 8px;
                Label { text: root.page == 0 ? "跑步工作台" : root.page == 1 ? "路线管理" : root.page == 2 ? "任务日志" : "关于软件"; font-size: 22px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                Action { height: 34px; text: root.dark ? "◐ 浅色外观" : "◐ 深色外观"; clicked => { root.dark = !root.dark; } }
                Action { height: 34px; text: root.logged-in ? "退出账号" : "登录账号"; enabled: !root.busy && !root.network-busy; clicked => { if root.logged-in { root.logout(); } else { root.prepare-login(); } } }
            }

            if root.notice != "": Rectangle {
                height: Math.max(36px, notice-label.preferred-height + 16px); background: Theme.soft; border-radius: 8px;
                notice-label := Text { x: 12px; y: 8px; width: parent.width - 24px; text: root.notice; color: Theme.accent; font-size: 12px; wrap: word-wrap; }
            }

            if root.page == 0 || root.page == 1: ScrollView {
                viewport-width: self.visible-width;
                HorizontalLayout {
                    spacing: 16px;
                    if root.page == 0: Card {
                        width: 300px; height: plan-layout.min-height;
                        plan-layout := VerticalLayout {
                            padding: 18px; spacing: 10px; alignment: start;
                            Label { text: "跑步计划"; font-size: 15px; font-weight: 600; }
                            Muted { text: "按日期向前生成，每天一条记录。"; }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                spacing: 14px;
                                Field { label: "跑步次数 / 次"; text <=> root.runs; enabled: !root.busy; }
                                Field { label: "单次距离 / km"; text <=> root.distance; enabled: !root.busy; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Field { label: "结束日期"; placeholder: "YYYY-MM-DD"; text <=> root.run-date; enabled: !root.busy; }
                                Field { label: "开始时间"; placeholder: "HH:MM:SS"; text <=> root.run-time; enabled: !root.busy; }
                            }
                            Muted { text: "开始时间会在设定值附近随机浮动。"; font-size: 11px; wrap: word-wrap; }
                            Rectangle { height: 1px; background: Theme.line; }
                            Label { text: "选择路线"; font-size: 12px; font-weight: 600; }
                            Select {
                                model: root.route-names;
                                current-index <=> root.route-index;
                                enabled: !root.busy;
                                selected(value) => { root.select-route(root.route-index); }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Action { text: "导入 TXT"; enabled: !root.busy; clicked => { root.import-route(); } }
                                Action { text: "设计路线 ↗"; clicked => { root.planner(); } }
                            }
                            VerticalLayout {
                                padding-top: 6px;
                                Rectangle {
                                height: 58px; border-radius: 8px; background: Theme.soft;
                                VerticalLayout {
                                    padding: 12px; spacing: 5px; alignment: start;
                                    Label { text: "开始前请检查预览"; color: Theme.accent; font-size: 12px; font-weight: 600; }
                                    Muted { text: "确认距离、起终点和路线连续性。"; font-size: 11px; }
                                }
                                }
                            }
                        }
                    }
                    Card {
                        min-width: 330px;
                        VerticalLayout {
                            padding: 20px; spacing: 12px;
                            Label { text: root.page == 1 ? "路线资料库" : "路线预览"; font-size: 15px; font-weight: 600; }
                            if root.page == 1: HorizontalLayout {
                                spacing: 10px;
                                Select { model: root.route-names; current-index <=> root.route-index; enabled: !root.busy; selected(value) => { root.select-route(root.route-index); } }
                                Action { text: "导入 TXT"; enabled: !root.busy; clicked => { root.import-route(); } }
                                Action { text: "删除"; danger: true; enabled: root.can-delete && !root.busy; clicked => { root.delete-open = true; } }
                            }
                            HorizontalLayout {
                                Label { text: root.route-title; font-weight: 600; font-size: 13px; }
                                Muted { text: root.can-delete ? "已导入 / BD09" : "内置 / BD09"; horizontal-alignment: right; font-size: 10px; }
                            }
                            Rectangle {
                                min-height: 180px;
                                vertical-stretch: 1;
                                border-radius: 10px;
                                background: Theme.soft;
                                Image { width: 100%; height: 100%; source: root.route-image; image-fit: contain; }
                                Rectangle {
                                    x: 12px; y: 12px; width: 102px; height: 25px; border-radius: 5px; background: Theme.card;
                                    Muted { text: "●  离线轨迹视图"; color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; }
                                }
                            }
                            Label { text: root.route-summary; font-size: 12px; }
                            Muted { text: root.preview-summary; font-size: 11px; wrap: word-wrap; }
                            if root.route-warning != "": Text { text: root.route-warning; color: #cf6351; font-size: 11px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                Action { text: "预览实际轨迹"; soft: true; enabled: !root.busy; clicked => { root.preview(); } }
                                Action { text: "在地图中打开 ↗"; clicked => { root.open-map(); } }
                                if root.page == 1: Action { text: "设计路线 ↗"; clicked => { root.planner(); } }
                            }
                        }
                    }
                }
            }

            if root.page == 2: Card {
                VerticalLayout {
                    padding: 20px; spacing: 18px;
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 6px;
                            Label { text: "运行记录"; font-size: 15px; font-weight: 600; }
                            Muted { text: "仅保留本次会话，不写入磁盘。"; wrap: word-wrap; }
                        }
                        Action { text: "清空日志"; height: 32px; clicked => { root.clear-log(); } }
                    }
                    ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            alignment: start;
                            Text { text: root.log-text == "" ? "暂无任务日志" : root.log-text; color: root.log-text == "" ? Theme.muted : Theme.ink; font-family: "Consolas"; font-size: 13px; wrap: word-wrap; vertical-stretch: 0; horizontal-alignment: left; vertical-alignment: top; }
                        }
                    }
                }
            }

            if root.page == 3: ScrollView {
                viewport-width: self.visible-width;
                VerticalLayout {
                    spacing: 16px; alignment: start;
                    Card {
                        height: 112px;
                        HorizontalLayout {
                            padding: 20px; spacing: 16px;
                            Rectangle {
                                width: 52px; background: transparent;
                                Image { source: @image-url("../../assets/SJTURM.png"); width: 52px; height: 52px; y: (parent.height - self.height) / 2; image-fit: contain; }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 6px;
                                Label { text: "SJTU RunningMan"; font-size: 19px; font-weight: 600; }
                                Muted { text: root.version; }
                                Muted { text: "基于 Rust 与 Slint 的原生桌面客户端"; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 20px; spacing: 14px; alignment: start;
                            Label { text: "更新与社区"; font-size: 15px; font-weight: 600; }
                            Muted { text: root.update-status; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                Action { text: "检查更新"; enabled: !root.network-busy; clicked => { root.check-update(); } }
                                Action {
                                    text: "GitHub ↗";
                                    icon: Theme.dark ? @image-url("../../assets/github-mark.svg") : @image-url("../../assets/github-mark-black.svg");
                                    clicked => { root.open-project(); }
                                }
                                Action {
                                    text: "讨论 ↗"; accessible-label: "水源社区讨论帖";
                                    icon: @image-url("../../assets/shuiyuan_logo.svg"); icon-width: 76px;
                                    icon-color: Theme.dark ? #aac8f3 : transparent;
                                    clicked => { root.open-shuiyuan(); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 20px; spacing: 10px; alignment: start;
                            Label { text: "使用说明"; font-size: 15px; font-weight: 600; }
                            Muted { text: "本项目仅用于学习、研究和技术测试。请遵守学校规定，不得伪造运动记录。\n账号、密码及会话只保留在内存中；本地仅保存外观、跑步参数和导入的路线。\n地图瓦片需要网络。轨迹预览以实际生成的 payload 为准。"; wrap: word-wrap; }
                        }
                    }
                }
            }

            if root.page == 0: Card {
                height: 74px;
                HorizontalLayout {
                    padding: 16px; spacing: 20px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        HorizontalLayout {
                            Label { text: root.busy ? "●  " + root.status : root.status; font-size: 12px; font-weight: 600; }
                            Muted { text: root.logged-in ? "会话已连接" : "尚未登录 · 可离线预览"; horizontal-alignment: right; font-size: 10px; }
                        }
                        Rectangle {
                            height: 6px; border-radius: 3px; background: Theme.progress-track;
                            accessible-role: progress-indicator; accessible-value: root.progress + "%";
                            Rectangle { x: 0px; y: 0px; width: parent.width * Math.max(0, Math.min(root.progress, 100)) / 100; height: 6px; border-radius: 3px; background: #1f6e4a; }
                        }
                    }
                    if !root.busy: Action { text: "开始任务"; height: 38px; primary: true; enabled: !root.network-busy; min-width: 108px; clicked => { if !root.logged-in { root.prepare-login(); } else { root.upload-open = true; } } }
                    if root.busy: Action { text: "停止任务"; height: 38px; danger: true; min-width: 108px; clicked => { root.stop-task(); } }
                }
            }
            if root.page != 0 && root.busy: Card {
                height: 44px;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 6px; spacing: 16px;
                    Label { text: root.status; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    Action { text: "停止任务"; height: 32px; danger: true; clicked => { root.stop-task(); } }
                }
            }
        }
    }

    if root.consent-open || root.login-stage > 0 || root.delete-open || root.upload-open: Rectangle {
        background: #0d211999;
        TouchArea { }
        Card {
            width: 500px;
            height: root.consent-open ? 500px : root.login-stage == 1 ? 440px : root.login-stage == 2 ? 365px : 245px;
            x: (parent.width - self.width)/2;
            y: (parent.height - self.height)/2;
            if root.consent-open: VerticalLayout {
                padding: 28px; spacing: 18px;
                Label { text: "使用承诺书"; font-size: 23px; font-weight: 700; }
                // 承诺条款沿用旧版 Qt 客户端的全文。不要套 ScrollView：放进去之后
                // Label 拿不到宽度约束，正文不换行、比视口宽，会被左右两头裁掉。
                Label {
                    text: "在继续使用本软件前，请认真阅读并作出承诺：\n\n1. 我理解本项目仅用于学习、研究和技术测试，主要用于理解运动数据记录与上传相关的技术流程。\n\n2. 我理解项目开发者反对任何违反学校规定的使用方式。\n\n3. 我承诺在使用前确认自己的行为符合上海交通大学校规及相关法律法规的要求。\n\n4. 我承诺不会将本软件用于伪造运动数据、规避体育锻炼要求或其他违规操作。";
                    wrap: word-wrap;
                }
                CheckBox { text: "我已阅读以上内容，并承诺不会将本软件用于任何违规操作。"; checked <=> root.consent-checked; }
                HorizontalLayout {
                    spacing: 12px;
                    Action { text: "退出"; clicked => { root.quit(); } }
                    Action { text: "我承诺，进入软件"; primary: true; enabled: root.consent-checked; clicked => { root.consent-open = false; } }
                }
            }
            if !root.consent-open && root.login-stage == 1: VerticalLayout {
                padding: 28px; spacing: 14px;
                Label { text: "连接 JAccount"; font-size: 23px; font-weight: 700; }
                Muted { text: "凭据仅发送给学校认证服务，不保存在本地。"; }
                Field { label: "JAccount 账号"; text <=> root.username; enabled: !root.network-busy; }
                Field { label: "密码"; text <=> root.password; secret: true; enabled: !root.network-busy; }
                HorizontalLayout {
                    spacing: 12px;
                    if root.manual-captcha: Field { label: "备用验证码"; text <=> root.captcha; enabled: !root.network-busy; }
                    if !root.manual-captcha: Muted { text: "图形验证码自动识别\n无需手动填写"; wrap: word-wrap; }
                    Image { source: root.captcha-image; width: 110px; height: 58px; image-fit: contain; }
                    Action { text: "刷新"; enabled: !root.network-busy; clicked => { root.prepare-login(); } }
                }
                Muted { text: root.notice; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    Action { text: "取消"; enabled: !root.network-busy; clicked => { root.cancel-login(); } }
                    Action { text: root.network-busy ? "连接中…" : "登录"; primary: true; enabled: !root.network-busy; clicked => { root.submit-login(); } }
                }
            }
            if !root.consent-open && root.login-stage == 2: VerticalLayout {
                padding: 28px; spacing: 18px;
                Label { text: "完成二次验证"; font-size: 23px; font-weight: 700; }
                Muted { text: "选择接收方式，发送并填写 6 位验证码。"; }
                HorizontalLayout {
                    spacing: 12px;
                    Select { label: "验证方式"; model: ["交我办", "邮箱", "短信"]; current-index <=> root.two-factor-method; enabled: !root.network-busy; }
                    Action { text: "发送验证码"; enabled: !root.network-busy; clicked => { root.send-code(); } }
                }
                Field { label: "验证码"; text <=> root.two-factor-code; enabled: !root.network-busy; }
                Muted { text: root.notice; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    Action { text: "取消"; enabled: !root.network-busy; clicked => { root.cancel-login(); } }
                    Action { text: "验证并继续"; primary: true; enabled: !root.network-busy; clicked => { root.verify-code(); } }
                }
            }
            if !root.consent-open && root.login-stage == 0 && root.delete-open: VerticalLayout {
                padding: 28px; spacing: 20px;
                Label { text: "删除这条路线？"; font-size: 23px; font-weight: 700; }
                Label { text: "只删除应用中导入的副本，源文件不受影响。\n" + root.route-title; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    Action { text: "保留路线"; clicked => { root.delete-open = false; } }
                    Action { text: "确认删除"; danger: true; clicked => { root.delete-open = false; root.delete-route(); } }
                }
            }
            if !root.consent-open && root.login-stage == 0 && root.upload-open: VerticalLayout {
                padding: 28px; spacing: 18px;
                Label { text: "确认开始任务"; font-size: 23px; font-weight: 700; }
                Label { text: "即将上传 " + root.runs + " 条记录，每条 " + root.distance + " km。\n请确认已预览实际轨迹，并遵守使用承诺。"; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    Action { text: "返回检查"; clicked => { root.upload-open = false; } }
                    Action { text: "确认开始"; primary: true; clicked => { root.upload-open = false; root.start-task(); } }
                }
            }
        }
    }
}
